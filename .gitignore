# CDK
cdk.out/
*.js.map

# Oracle container volumes
oradata/

# Ephemeral agent worktrees — never part of the repo
.claude/worktrees/

# Logs, all in logs/. install_cdk.sh writes one per run there; they are local
# troubleshooting output and name account-specific resources. *.log catches a
# log written anywhere else.
logs/
*.log

# Office lock files
~$*

# Local logical exports of demo databases. Contain synthetic PII-shaped data.
backups/

# Generated by `cdk deploy --outputs-file`; holds account, VPC and ARN identifiers
frontend/backend_outputs*.json
# Account-keyed lookup cache written by CDK
backend/cdk.context.json
backend/cdk.out*/
# Editor and tool backups, recordings, and drafts
*.bak
docs/.$*.bkp
docs/*.mp4
docs/*.m4a
*.docx

# Local deployment values (account, VPC and subnet ids)
deploy.env

# Generated by deploys, and local copies
frontend/src/adam_ui/.env.local*
/dev_*.png
docs/*.pre-decoupling.*

# CDK lookup cache; keyed by account id
backend/cdk.context.json
.ash/ash_output/
.env.test

# Live values for one deployment (copied from stack outputs); never tracked
docs/QuickMCPConnectorSettings_external.md
