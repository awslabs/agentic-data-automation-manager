# Copy to deploy.env (git-ignored) and fill in. install_cdk.sh reads it and asks
# for anything missing. The stack deploys into this VPC; it creates no database.

# AWS profile and region of the target account.
DEPLOY_PROFILE=
DEPLOY_REGION=

# The existing network. Give one availability zone per subnet, in the same order:
# the two lists are paired by position. Use a separate VPC for each stage: a stage
# deployed into another stage's VPC reuses that stage's endpoints, so deleting
# that stage (dev, say) deletes them and cuts off this one (prod).
VPC_ID=
APP_SG_ID=
# For example subnet-aaaa,subnet-bbbb
PRIVATE_SUBNET_IDS=
# For example us-east-1b,us-east-1c
AVAILABILITY_ZONES=
# The VPC's CIDR block, for example 10.0.0.0/16
VPC_CIDR_BLOCK=

# Optional. A VPC whose DynamoDB traffic goes through an interface endpoint: its DNS name.
DYNAMODB_ENDPOINT_URL=

# Optional, default true: the agent runtime behind the website's Chat page (an image
# build and three more VPC endpoints: ecr.api, ecr.dkr, logs). false leaves it out;
# Quick needs none of it.
ENABLE_CHAT=

# Optional. true adds the web_search tool (Amazon Nova web grounding, US Regions only): the
# agent can send a query, written from the conversation, to a web search outside your VPC.
# Off when empty or false.
ENABLE_WEB_SEARCH=

# Optional. true deploys a private Redshift Serverless workgroup (4 RPU, billed only
# while queries run) for the Redshift provider's integration tests. The app never uses it.
REDSHIFT_TEST_TARGET=
